[Tests]
  design = 'source/mfem/utils/BuildMFEMMesh.md'
  issues = '#32520'
  [LibMeshToMFEMMesh]
    requirement = 'It shall be possible to create MFEM meshes from LibMesh ones, including on meshes made from '
    [H1Quad]
      type = CSVDiff
      input = libmesh_parent.i
      csvdiff = 'libmesh_to_mfem_mesh_quads.csv'
      detail = 'first order quads, '
      abs_zero = 1e-8
      capabilities = 'mfem'
      recover = false
      compute_devices = 'cpu cuda'
    []
    [H1Hex]
      type = CSVDiff
      input = libmesh_parent.i
      csvdiff = 'libmesh_to_mfem_mesh_hexes.csv'
      detail = 'first order hexes, '
      abs_zero = 1e-8
      capabilities = 'mfem'
      recover = false
      compute_devices = 'cpu cuda'
      cli_args = 'Mesh/file=../hex-8.e
                 Outputs/file_base=libmesh_to_mfem_mesh_hexes'
    []
